# Supabase project: ledgerguard (ref rtlwsuvpwszrvwolzybc, us-east-1, free tier)
SUPABASE_URL=https://rtlwsuvpwszrvwolzybc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://rtlwsuvpwszrvwolzybc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is NOT retrievable via the Supabase MCP tools — copy it
# from Project Settings > API > service_role in the dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Reused from the portfolio's other Claude-backed projects (grounded-rag,
# SignalDesk) — same key, same billing account.
ANTHROPIC_API_KEY=

# Reuse-stack config (ported pattern from SignalDesk/grounded-rag)
DAILY_SPEND_CAP_USD=5
RATE_LIMIT_PER_HOUR=20

# Upload sandbox (bring-your-own-invoice demo, see ledgerguard.md).
# Feature-flagged off by default — set to "true" only after Turnstile keys
# below are real and the abuse-testing pass (Phase 4) is done.
UPLOAD_SANDBOX_ENABLED=false

# Cloudflare Turnstile — CLAUDE.md section 18 lists this as owed by both
# sibling projects too. Without a secret key set, /api/upload logs a
# warning and passes every request through unprotected (see
# lib/upload/turnstile.ts) — never leave UPLOAD_SANDBOX_ENABLED=true in
# production without this set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Authorizes GET /api/upload/cleanup (the daily deletion-backstop cron
# Vercel calls per vercel.json). Generate with `openssl rand -hex 32`.
CRON_SECRET=
